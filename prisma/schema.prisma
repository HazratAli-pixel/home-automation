generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
  GUEST
}

enum SwitchState {
  ON
  OFF
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           Role      @default(GUEST)
  homeId         String?
  home           Home?     @relation(fields: [homeId], references: [id], onDelete: SetNull)
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Home {
  id         String   @id @default(cuid())
  name       String
  users      User[]
  rooms      Room[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Room {
  id         String   @id @default(cuid())
  name       String
  homeId     String
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  devices    Device[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([homeId])
}

model Device {
  id          String        @id @default(cuid())
  name        String
  roomId      String
  room        Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type        String
  isOnline    Boolean       @default(false)
  switches    Switch[]
  logs        DeviceLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([roomId])
}

model Switch {
  id          String      @id @default(cuid())
  name        String
  deviceId    String
  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  state       SwitchState @default(OFF)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([deviceId])
}

model DeviceLog {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([deviceId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
